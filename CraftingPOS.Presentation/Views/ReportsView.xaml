<UserControl x:Class="CraftingPOS.Presentation.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F4F6">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Reports" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A"/>

            <!-- Controls -->
            <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Report" FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ReportKinds}" SelectedItem="{Binding SelectedReportKind}"
                                  Width="180" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Visibility="{Binding ShowDateRange, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="From" FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Width="140" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Visibility="{Binding ShowDateRange, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="To" FontSize="11" Foreground="Gray" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Width="140" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6" Visibility="{Binding ShowLowStockToggle, Converter={StaticResource BoolToVis}}"
                                VerticalAlignment="Bottom">
                        <CheckBox Content="Low Stock Only" IsChecked="{Binding LowStockOnly}"/>
                    </StackPanel>

                    <Button Grid.Column="8" Content="Generate" Height="34" Padding="16,0" Margin="0,18,8,0"
                            Background="#1E3A8A" Foreground="White" FontWeight="Bold"
                            Command="{Binding GenerateCommand}"/>

                    <StackPanel Grid.Column="9" Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Export PDF" Height="34" Padding="10,0" Margin="0,0,6,0"
                                Background="#DC2626" Foreground="White"
                                Command="{Binding ExportPdfCommand}"/>
                        <Button Content="Export Excel" Height="34" Padding="10,0"
                                Background="#16A34A" Foreground="White"
                                Command="{Binding ExportExcelCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Results -->
            <Border Grid.Row="4" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#EFF6FF" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                            Visibility="{Binding SummaryLine, Converter={StaticResource StringToVisConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding SummaryLine}" FontWeight="Bold" Foreground="#1E3A8A" TextWrapping="Wrap"/>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="ReportGrid"
                              ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="32"
                              CanUserAddRows="False"/>
                </Grid>
            </Border>
        </Grid>

        <Border Background="#AAFFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Generating report..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
        </Border>
    </Grid>
</UserControl>