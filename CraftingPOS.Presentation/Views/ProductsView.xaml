<UserControl x:Class="CraftingPOS.Presentation.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

	<UserControl.Resources>
		<Style x:Key="PanelStyle" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="18"/>
		</Style>
		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="Gray"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
		</Style>
		<Style x:Key="FieldBox" TargetType="TextBox">
			<Setter Property="Padding" Value="6"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
		</Style>
	</UserControl.Resources>

	<Grid Background="#F3F4F6">
		<Grid Margin="24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="12"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="12"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*"/>
				<ColumnDefinition Width="16"/>
				<ColumnDefinition Width="1*" MinWidth="360"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="Product Management" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A"/>

			<!-- Search bar -->
			<Grid Grid.Row="2" Grid.Column="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="100"/>
				</Grid.ColumnDefinitions>
				<TextBox Grid.Column="0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" FontSize="13"/>
				<Button Grid.Column="1" Content="Search" Margin="8,0,0,0"
                        Background="#1E3A8A" Foreground="White"
                        Command="{Binding SearchCommand}"/>
			</Grid>

			<!-- Left: Product Grid -->
			<Border Grid.Row="4" Grid.Column="0" Style="{StaticResource PanelStyle}">
				<DataGrid ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="34"
                          CanUserAddRows="False">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="Auto"/>
						<DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="Auto"/>
						<DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
						<DataGridTextColumn Header="Type" Binding="{Binding ProductType}" Width="Auto"/>
						<DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="Auto"/>
						<DataGridTextColumn Header="Brand" Binding="{Binding BrandName}" Width="Auto"/>
						<DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="Auto"/>
						<DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat='Rs. {0:N0}'}" Width="Auto"/>
						<DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat='Rs. {0:N0}'}" Width="Auto"/>
						<DataGridTemplateColumn Header="" Width="100">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button Content="Deactivate"
                                            FontSize="11" Padding="6,2"
                                            Background="#FEE2E2" Foreground="#B91C1C" BorderThickness="0"
                                            Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- Right: Add/Edit Form (Product + Variants) -->
			<Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
				<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
					<StackPanel>
						<TextBlock Text="{Binding FormHeader}" FontWeight="Bold" FontSize="15" Margin="0,0,0,14"/>

						<TextBlock Text="Category *" Style="{StaticResource FieldLabel}"/>
						<ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding FormCategory}"
                                  DisplayMemberPath="Name"
                                  Padding="6" Margin="0,0,0,10"/>

						<TextBlock Text="Brand (optional)" Style="{StaticResource FieldLabel}"/>
						<ComboBox ItemsSource="{Binding Brands}"
								  SelectedItem="{Binding FormBrand}"
								  DisplayMemberPath="Name"
								  Padding="6" Margin="0,0,0,10"/>

						<TextBlock Text="Product Type" Style="{StaticResource FieldLabel}"/>
						<ComboBox ItemsSource="{Binding ProductTypes}"
                                  SelectedItem="{Binding FormProductType}"
                                  Padding="6" Margin="0,0,0,10"/>

						<TextBlock Text="Barcode *" Style="{StaticResource FieldLabel}"/>
						<TextBox Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

						<TextBlock Text="SKU *" Style="{StaticResource FieldLabel}"/>
						<TextBox Text="{Binding FormSku, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

						<TextBlock Text="Name *" Style="{StaticResource FieldLabel}"/>
						<TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

						<TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
						<TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" Style="{StaticResource FieldBox}"/>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="10"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<TextBlock Text="Cost Price *" Style="{StaticResource FieldLabel}"/>
								<TextBox Text="{Binding FormCostPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="Selling Price *" Style="{StaticResource FieldLabel}"/>
								<TextBox Text="{Binding FormSellingPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
							</StackPanel>
						</Grid>

						<Grid Visibility="{Binding IsVariableProductType, Converter={StaticResource InverseBoolToVis}}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="10"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0">
								<TextBlock Text="Current Stock" Style="{StaticResource FieldLabel}"/>
								<TextBox Text="{Binding FormCurrentStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Text="Minimum Stock" Style="{StaticResource FieldLabel}"/>
								<TextBox Text="{Binding FormMinimumStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
							</StackPanel>
						</Grid>

						<TextBlock Text="For Variable products, stock is tracked per-variant below instead of on the parent product."
                                   FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding IsVariableProductType, Converter={StaticResource BoolToVis}}"/>

						<TextBlock Text="Product Image" Style="{StaticResource FieldLabel}"/>
						<Grid Margin="0,0,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="90"/>
							</Grid.ColumnDefinitions>
							<TextBox Grid.Column="0" Text="{Binding FormImageSourcePath, Mode=OneWay}"
                                     IsReadOnly="True" Padding="6" FontSize="12"/>
							<Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0"
                                    Command="{Binding BrowseImageCommand}"/>
						</Grid>

						<TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,10">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Foreground" Value="#16A34A"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasError}" Value="True">
											<Setter Property="Foreground" Value="#DC2626"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>

						<UniformGrid Columns="2" Rows="1">
							<Button Content="Save" Height="34" Margin="0,0,6,0"
                                    Background="#1E3A8A" Foreground="White" FontWeight="Bold"
                                    Command="{Binding SaveCommand}"/>
							<Button Content="Clear / New" Height="34" Margin="6,0,0,0"
                                    Background="#E5E7EB"
                                    Command="{Binding NewProductCommand}"/>
						</UniformGrid>

						<!-- ===================== VARIANTS SECTION ===================== -->

						<Separator Margin="0,18,0,12" Visibility="{Binding IsVariableProductType, Converter={StaticResource BoolToVis}}"/>

						<TextBlock Text="Product Variants" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                                   Visibility="{Binding IsVariableProductType, Converter={StaticResource BoolToVis}}"/>

						<TextBlock Text="Save the product first, then add its variants below — e.g. sizes (Small, Medium, Large), pack sizes (500ml, 1 Liter, 1.5 Liter, 2 Liter), colors, or types (Sugar Free, Regular)."
                                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding ShowVariantsSaveFirstMessage, Converter={StaticResource BoolToVis}}"/>

						<StackPanel Visibility="{Binding ShowVariantsPanel, Converter={StaticResource BoolToVis}}">

							<DataGrid ItemsSource="{Binding Variants}"
                                      SelectedItem="{Binding SelectedVariant}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowHeight="30"
                                      MaxHeight="180"
                                      CanUserAddRows="False"
                                      Margin="0,0,0,12">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Variant" Binding="{Binding VariantName}" Width="*"/>
									<DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="Auto"/>
									<DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="Auto"/>
									<DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat='Rs. {0:N0}'}" Width="Auto"/>
									<DataGridTemplateColumn Header="" Width="80">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Button Content="Remove" FontSize="10" Padding="4,1"
                                                        Background="#FEE2E2" Foreground="#B91C1C" BorderThickness="0"
                                                        Command="{Binding DataContext.DeactivateVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>

							<TextBlock Text="{Binding VariantFormHeader}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

							<TextBlock Text="Variant Name * (e.g. Small, Red - Large, 1 Liter, Sugar Free)" Style="{StaticResource FieldLabel}"/>
							<TextBox Text="{Binding VariantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="10"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="Barcode *" Style="{StaticResource FieldLabel}"/>
									<TextBox Text="{Binding VariantBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Text="SKU *" Style="{StaticResource FieldLabel}"/>
									<TextBox Text="{Binding VariantSku, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
								</StackPanel>
							</Grid>

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="10"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="Cost Price *" Style="{StaticResource FieldLabel}"/>
									<TextBox Text="{Binding VariantCostPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Text="Selling Price *" Style="{StaticResource FieldLabel}"/>
									<TextBox Text="{Binding VariantSellingPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
								</StackPanel>
							</Grid>

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="10"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="Current Stock" Style="{StaticResource FieldLabel}"/>
									<TextBox Text="{Binding VariantCurrentStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Text="Minimum Stock" Style="{StaticResource FieldLabel}"/>
									<TextBox Text="{Binding VariantMinimumStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
								</StackPanel>
							</Grid>

							<TextBlock Text="{Binding VariantStatusMessage}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,10">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Foreground" Value="#16A34A"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding VariantHasError}" Value="True">
												<Setter Property="Foreground" Value="#DC2626"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>

							<UniformGrid Columns="2" Rows="1">
								<Button Content="Add / Update Variant" Height="32" Margin="0,0,6,0"
                                        Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="12"
                                        Command="{Binding SaveVariantCommand}"/>
								<Button Content="Clear Variant Form" Height="32" Margin="6,0,0,0"
                                        Background="#E5E7EB" FontSize="12"
                                        Command="{Binding NewVariantCommand}"/>
							</UniformGrid>
						</StackPanel>
						<!-- =================== END VARIANTS SECTION =================== -->

					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>

		<Border Background="#AAFFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
			<TextBlock Text="Working..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
		</Border>
	</Grid>
</UserControl>