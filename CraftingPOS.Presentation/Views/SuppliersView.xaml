<UserControl x:Class="CraftingPOS.Presentation.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F4F6">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="Supplier Management" FontSize="24" FontWeight="Bold" Foreground="#1E3A8A"/>

            <!-- Left: Supplier Grid -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelStyle}">
                <DataGrid ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="34"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Contact Person" Binding="{Binding ContactPerson}" Width="*"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="Auto"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        <DataGridTemplateColumn Header="" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Purchase History"
                                                FontSize="11" Padding="6,2" Margin="0,0,6,0"
                                                Background="#DBEAFE" Foreground="#1E3A8A" BorderThickness="0"
                                                Command="{Binding DataContext.ViewHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Deactivate"
                                                FontSize="11" Padding="6,2"
                                                Background="#FEE2E2" Foreground="#B91C1C" BorderThickness="0"
                                                Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right: Add/Edit Form OR Purchase History -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelStyle}" VerticalAlignment="Top">
                <Grid>
                    <!-- Add/Edit Form -->
                    <StackPanel Visibility="{Binding IsViewingHistory, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{Binding FormHeader}" FontWeight="Bold" FontSize="15" Margin="0,0,0,14"/>

                        <TextBlock Text="Name *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

                        <TextBlock Text="Contact Person" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormContactPerson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

                        <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Style="{StaticResource FieldBox}"/>

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Style="{StaticResource FieldBox}"/>

                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#16A34A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <UniformGrid Columns="2" Rows="1">
                            <Button Content="Save" Height="34" Margin="0,0,6,0"
                                    Background="#1E3A8A" Foreground="White" FontWeight="Bold"
                                    Command="{Binding SaveCommand}"/>
                            <Button Content="Clear / New" Height="34" Margin="6,0,0,0"
                                    Background="#E5E7EB"
                                    Command="{Binding NewSupplierCommand}"/>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Purchase History Panel -->
                    <StackPanel Visibility="{Binding IsViewingHistory, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="{Binding HistoryHeader}" FontWeight="Bold" FontSize="15"/>
                            <Button Content="✕ Close" HorizontalAlignment="Right"
                                    FontSize="11" Padding="6,2" Background="Transparent" BorderThickness="0"
                                    Command="{Binding CloseHistoryCommand}"/>
                        </Grid>

                        <TextBlock Text="No purchase history yet. This will populate automatically once purchases are recorded."
                                   Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"
                                   Visibility="{Binding HasPurchaseHistory, Converter={StaticResource InverseBoolToVis}}"/>

                        <ItemsControl ItemsSource="{Binding PurchaseHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0">
                                            <Run Text="{Binding InvoiceNumber}"/>
                                            <LineBreak/>
                                            <Run Text="{Binding PurchaseDate, StringFormat='dd MMM yyyy'}" Foreground="Gray" FontSize="11"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='Rs. {0:N0}'}"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Background="#AAFFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Working..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
        </Border>
    </Grid>
</UserControl>