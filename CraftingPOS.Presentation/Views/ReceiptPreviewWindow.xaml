<Window x:Class="CraftingPOS.Presentation.Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt Preview" Height="620" Width="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Paper Width:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton Content="58mm" GroupName="PaperWidth" Margin="0,0,16,0"
                         IsChecked="{Binding SelectedPaperWidth, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Width58mm}"/>
            <RadioButton Content="80mm" GroupName="PaperWidth"
                         IsChecked="{Binding SelectedPaperWidth, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Width80mm}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding PreviewText}"
                           FontFamily="Consolas" FontSize="12"
                           TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Print" Height="34" Margin="0,0,6,0"
                    Background="#1E3A8A" Foreground="White" FontWeight="Bold"
                    Command="{Binding PrintCommand}"
                    Visibility="{Binding HasPrintedOnce, Converter={StaticResource InverseBoolToVis}}"/>
            <Button Grid.Column="0" Content="Reprint" Height="34" Margin="0,0,6,0"
                    Background="#1E3A8A" Foreground="White" FontWeight="Bold"
                    Command="{Binding PrintCommand}"
                    Visibility="{Binding HasPrintedOnce, Converter={StaticResource BoolToVis}}"/>

            <Button Grid.Column="2" Content="Close" Height="34" Margin="6,0,0,0"
                    Background="#E5E7EB" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>