<UserControl x:Class="CraftingPOS.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F4F6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>

                <!-- Header row: title + live clock -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Dashboard"
                               FontSize="24" FontWeight="Bold" Foreground="#1E3A8A"/>

                    <TextBlock Grid.Column="1" Text="{Binding CurrentDateTime}"
                               FontSize="13" Foreground="Gray"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Stat Cards Row 1: Sales / Profit -->
                <UniformGrid Columns="2" Rows="1">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="TODAY'S SALES" Style="{StaticResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding TodaysSales, StringFormat='Rs. {0:N0}'}"
                                       Style="{StaticResource CardValueStyle}" Foreground="#2563EB"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="TODAY'S PROFIT" Style="{StaticResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding TodaysProfit, StringFormat='Rs. {0:N0}'}"
                                       Style="{StaticResource CardValueStyle}" Foreground="#16A34A"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Stat Cards Row 2: Products / Customers / Suppliers -->
                <UniformGrid Columns="3" Rows="1">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="PRODUCTS" Style="{StaticResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding TotalProducts}" Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="CUSTOMERS" Style="{StaticResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding TotalCustomers}" Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="SUPPLIERS" Style="{StaticResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding TotalSuppliers}" Style="{StaticResource CardValueStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Low Stock + Recent Sales -->
                <UniformGrid Columns="2" Rows="1">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Low Stock Alerts" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                            <TextBlock Text="No low stock items."
                                       Foreground="Gray" FontStyle="Italic"
                                       Visibility="{Binding HasLowStockItems, Converter={StaticResource InverseBoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding LowStockItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}"/>
                                            <TextBlock Grid.Column="1" Foreground="#DC2626" FontWeight="Bold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} / {1}">
                                                        <Binding Path="CurrentStock"/>
                                                        <Binding Path="MinimumStock"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Recent Sales" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                            <TextBlock Text="No sales recorded yet."
                                       Foreground="Gray" FontStyle="Italic"
                                       Visibility="{Binding HasRecentSales, Converter={StaticResource InverseBoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding RecentSales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding InvoiceNumber}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat='Rs. {0:N0}'}"
                                                       FontWeight="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </UniformGrid>

            </StackPanel>
        </ScrollViewer>

        <!-- Busy overlay -->
        <Border Background="#AAFFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Loading dashboard..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
        </Border>
    </Grid>
</UserControl>