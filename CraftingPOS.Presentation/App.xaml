<Application x:Class="CraftingPOS.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CraftingPOS.Presentation.Converters">
	<Application.Resources>
		<conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
		<conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
		<conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
		<conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
		<conv:StringToVisibilityConverter x:Key="StringToVisConverter"/>
	</Application.Resources>
</Application>